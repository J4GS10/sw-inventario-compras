{
  "name": "@sw-inventario/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:entities": "tsx scripts/gen-entities.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@fastify/multipart": "^10.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "fastify": "5.1.0",
    "oracledb": "6.7.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/oracledb": "6.5.1",
    "@types/pdfkit": "^0.17.6",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
