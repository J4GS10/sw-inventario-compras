# Copia este archivo a `.env` (raiz del repo) y ajusta los valores. NUNCA subas `.env` a git.

# --- Base de datos Oracle 21c ---
DB_USER=admin_proyecto
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=proyecto
DB_CONNECT_STRING=localhost:1521/proyecto

# --- Backend HTTP ---
HTTP_PORT=3000

# --- Autenticacion ---
# Cadena larga aleatoria (obligatoria en produccion):  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Atajo X-Dev-User: SOLO desarrollo (en produccion se ignora). Deja 0 si dudas.
APP_DEV_AUTH=0

# --- Almacenamiento de adjuntos y PDF (S3 compatible: MinIO local) ---
S3_BUCKET=com-adjuntos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
ADJUNTO_MAX_BYTES=15728640

# --- Empresa emisora (membrete de los PDF) ---
# EMPRESA_NOMBRE=Clavos S.A.
# EMPRESA_NIT=
# EMPRESA_DIRECCION=
# EMPRESA_TELEFONO=
